{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telephony Plugin Permissions",
  "description": "Permissions for the Tauri Telephony Plugin",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "description": "Permission identifier"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what this permission allows"
    },
    "commands": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of allowed commands"
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of denied commands"
        }
      }
    }
  }
}
